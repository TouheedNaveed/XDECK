{
  "name": "xdeck-desktop",
  "version": "1.1.9",
  "description": "XDECK - Turn Your Phone Into a Stream Deck",
  "main": "dist/desktop-app/src/main/index.js",
  "author": {
    "name": "XDECK",
    "email": "support@xdeck.app"
  },
  "homepage": "https://xdeck.app",
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:electron": "tsc --skipLibCheck && node scripts/build-prepare.js && electron . --no-sandbox --ozone-platform-hint=x11",
    "build": "tsc --skipLibCheck && node scripts/build-prepare.js && electron-builder",
    "build:linux": "tsc --skipLibCheck && node scripts/build-prepare.js && electron-builder --linux deb appimage",
    "build:win": "tsc --skipLibCheck && node scripts/build-prepare.js && electron-builder --win",
    "build:mac": "tsc --skipLibCheck && node scripts/build-prepare.js && electron-builder --mac",
    "publish": "tsc --skipLibCheck && node scripts/build-prepare.js && electron-builder --publish always",
    "start": "electron dist/desktop-app/src/main/index.js"
  },
  "build": {
    "appId": "com.xdeck.desktop",
    "productName": "XDECK",
    "artifactName": "${productName}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/desktop-app/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "TouheedNaveed",
      "repo": "XDECK",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "XDECK"
    }
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
